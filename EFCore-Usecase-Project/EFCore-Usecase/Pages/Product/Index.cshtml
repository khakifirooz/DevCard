@page
@model IndexModel
@{
}

<div class="text-center">
    <h1 class="display-4">لیست محصولات</h1>
    <p><a asp-page="./Create" class="btn btn-success">ایجاد جدید</a></p>
</div>

<table class="table table-responsive table-bordered table-striped">
    <thead>
        <tr>
            <td>#</td>
            <td>نام</td>
            <td>قیمت</td>
            <td>نام گروه</td>
            <td>تاریخ ایجاد</td>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model.products)
        {
            <tr>
                <th>@item.Id</th>
                <th>@item.Name</th>
                <th>@item.UnitPrice</th>
                <th>@item.Category</th>
                <th>@item.CreationDate</th>
                <th>
                    <a class="btn btn-success" asp-page= "./Edit" asp-route-id="@item.Id">ویرایش</a>
                    @if(!item.IsRemoved)
                    {
                        <a class="btn btn-danger" asp-page-handler="Remove" asp-page="./Index" asp-route-id="@item.Id">غیرفعال</a>
                    }
                    else
                    {
                        <a class="btn btn-success" asp-page-handler="ReStore" asp-page="./Index" asp-route-id="@item.Id">فعال سازی</a>
                    }
                </th>
            </tr>
        }

    </tbody>

</table>
